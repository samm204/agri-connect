# Copy to .env for local use (.env is git-ignored) or enter these in the hosting dashboard.
# Do NOT put real secrets in this example file.
NODE_ENV=development
PORT=3000
# Required when NODE_ENV=production. 8+ characters, with a letter and a number.
ADMIN_PASSWORD=change-me-before-production-1
# Optional. Default: db/agriconnect.sqlite
# DATABASE_FILE=/var/data/agriconnect.sqlite
